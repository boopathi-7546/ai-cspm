# ==============================================================================
# AI-CSPM Configuration & Environment Variables Example
# Copy to .env and configure as needed. NEVER commit your actual .env file.
# ==============================================================================

# Database Path
# CSPM_DB=./cspm.db

# Flask Application & Authentication Security
# Set CSPM_REQUIRE_AUTH=true to enforce login on dashboard, scan, and upload APIs
CSPM_REQUIRE_AUTH=false
CSPM_ADMIN_USER=admin
CSPM_ADMIN_PASSWORD=change-this-secure-password
CSPM_SECRET_KEY=generate-a-strong-random-hex-string-for-sessions

# Optional LLM Threat Intelligence & Explanation wow
# Provider: "anthropic" (default) or "gemini"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# CTI_LLM_MODEL=claude-sonnet-5-5
# For Gemini: CTI_LLM_MODEL=gemini-2.0-flash
CTI_LLM_DELAY_SECONDS=0

# Real-Time Webhook Alerting (Slack, MS Teams, Generic Webhook)
# Triggers on critical attack paths or critical risk discoveries
CSPM_SLACK_WEBHOOK_URL=
CSPM_TEAMS_WEBHOOK_URL=
CSPM_WEBHOOK_URL=

# Optional Live Cloud Scanning (Least-Privilege Read-Only)
# Only accessed when explicitly invoking 'python run.py aws-scan / azure-scan / gcp-scan'
# AWS
AWS_REGION=us-east-1
AWS_PROFILE=default

# Azure (Uses DefaultAzureCredential: az login, Service Principal, or Managed Identity)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# GCP (Uses Application Default Credentials: gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
